generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transcript {
  id                        String   @id @default(uuid())
  title                     String
  event_date                DateTime
  speech_type               String   // e.g. "Remarks", "Press Conference", "Interview", "Sports Commentary"
  primary_speaker           String   // e.g. "Donald Trump", "Zohran Mamdani"
  speakers_present          String[] // e.g. ["Zohran Mamdani", "Kayla Santos Rosso"]
  has_q_and_a               Boolean  @default(false)
  total_speech_length_seconds Int?   // manual or calculated from segments
  key_themes                String[] // manual tags e.g. ["Coney Island", "BID", "Small Business"]

  // Earnings call metadata (nullable to not affect existing political transcripts)
  company_ticker            String?  // e.g. "NVDA"
  fiscal_year               Int?     // e.g. 2026
  fiscal_quarter            Int?     // 1-4
  source                    String?  // e.g. "yahoo"
  source_url                String?  @unique // canonical dedupe key (URL of transcript article)
  earnings_key              String?  @unique // stable key: `${ticker}:FY${year}:Q${q}` for earnings calls

  // Q&A Analytics
  question_count            Int?     // total number of questions in curated qa_data
  avg_response_length_words Int?     // average response length in words (curated)
  avg_response_length_seconds Float? // average response duration in seconds (curated)
  qa_data                   Json?    // curated Q&A pairs shown to users: [{qaKey, question, response, …}]
  qa_data_auto              Json?    // last auto-detected pairs before any user edits
  qa_overrides              Json?    // { removedKeys: string[] } — user removals that survive re-parse

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  segments SpeakingSegment[]

  @@index([event_date])
  @@index([primary_speaker])
  @@index([speech_type])
  @@index([has_q_and_a])
  @@index([company_ticker, event_date])
  @@index([company_ticker, fiscal_year, fiscal_quarter])
}

model SpeakingSegment {
  id            String  @id @default(uuid())
  transcriptId  String
  speaker       String
  start_seconds Float   // e.g. 130.5 for 2:10.5
  end_seconds   Float?  // null if unknown
  text          String  // the spoken content in this turn

  transcript Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@index([transcriptId])
  @@index([transcriptId, start_seconds])
  @@index([speaker])
}

/** Feedback log for Q&A auto-detection corrections (foundation for future learning). */
model QADetectionFeedback {
  id            String   @id @default(uuid())
  transcriptId  String
  qaKey         String   // matches QAPair.qaKey — `${questionSpeaker}:${questionStart}`
  action        String   // "removed" | "restored"
  pairSnapshot  Json     // full QAPair at time of action
  created_at    DateTime @default(now())

  @@index([transcriptId])
  @@index([action])
  @@index([created_at])
}

